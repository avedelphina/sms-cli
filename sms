#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${SMS_CONFIG:-$HOME/.config/sms-cli/sms.conf}"

if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$CONFIG_FILE"
fi

MODEM_ID="${MODEM_ID:-0}"
CREDIT_USSD="${CREDIT_USSD:-*100#}"
CREDIT_METHOD="${CREDIT_METHOD:-ussd}"
CREDIT_SMS_NUMBER="${CREDIT_SMS_NUMBER:-4603}"
CREDIT_SMS_TEXT="${CREDIT_SMS_TEXT:-KREDIT S}"
AUTO_DETECT_MODEM="${AUTO_DETECT_MODEM:-1}"

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Missing required command: $1" >&2
    exit 1
  }
}

usage() {
  cat <<USAGE
Usage:
  sms list
  sms read <id>
  sms read-all
  sms send [--dry-run] <number-or-contact> <message>
  sms reply [--dry-run] <id> <message>
  sms send-template <name> [number] [template_args...]
  sms templates
  sms contacts
  sms credit-status [--dry-run]

Config file:
  $CONFIG_FILE

credit-status modes:
  CREDIT_METHOD=ussd -> uses CREDIT_USSD
  CREDIT_METHOD=sms  -> sends CREDIT_SMS_TEXT to CREDIT_SMS_NUMBER
USAGE
}

resolve_sms_path() {
  local id="$1"
  if [[ "$id" == /org/freedesktop/ModemManager1/SMS/* ]]; then
    printf '%s\n' "$id"
  else
    printf '/org/freedesktop/ModemManager1/SMS/%s\n' "$id"
  fi
}

extract_path() {
  grep -o '/org/freedesktop/ModemManager1/SMS/[0-9]\+' | head -n1
}

detect_first_modem_id() {
  need_cmd mmcli
  mmcli -L 2>/dev/null | sed -n 's#.*Modem/\([0-9]\+\).*#\1#p' | head -n1
}

ensure_modem_id() {
  need_cmd mmcli

  if mmcli -m "$MODEM_ID" >/dev/null 2>&1; then
    return 0
  fi

  if [[ "$AUTO_DETECT_MODEM" != "1" ]]; then
    echo "Configured MODEM_ID=$MODEM_ID not found and AUTO_DETECT_MODEM is disabled" >&2
    exit 1
  fi

  local detected
  detected="$(detect_first_modem_id)"
  if [[ -z "$detected" ]]; then
    echo "Could not find any modem via mmcli -L" >&2
    exit 1
  fi

  MODEM_ID="$detected"
  echo "Using auto-detected MODEM_ID=$MODEM_ID (configured modem not found)" >&2
}

escape_mmcli_value() {
  # mmcli expects values wrapped in single quotes.
  # Escape inner single quotes so text like "I'm here" works.
  printf "%s" "$1" | sed "s/'/'\\\\''/g"
}

is_phone_number() {
  [[ "$1" =~ ^\+?[0-9]{3,}$ ]]
}

resolve_recipient() {
  local recipient="$1"

  if is_phone_number "$recipient"; then
    printf '%s\n' "$recipient"
    return 0
  fi

  if declare -p SMS_CONTACTS >/dev/null 2>&1 && [[ -n "${SMS_CONTACTS[$recipient]-}" ]]; then
    printf '%s\n' "${SMS_CONTACTS[$recipient]}"
    return 0
  fi

  echo "Recipient must be a phone number or configured contact: $recipient" >&2
  exit 1
}

render_template() {
  local template="$1"
  shift
  local i=1
  local value
  for value in "$@"; do
    template="${template//\{$i\}/$value}"
    i=$((i + 1))
  done
  printf '%s\n' "$template"
}

list_sms() {
  ensure_modem_id
  mmcli -m "$MODEM_ID" --messaging-list-sms
}

read_sms() {
  ensure_modem_id
  local id="$1"
  local sms_path
  sms_path="$(resolve_sms_path "$id")"
  mmcli -s "$sms_path"
}

read_all_sms() {
  ensure_modem_id

  local sms_ids
  sms_ids="$(mmcli -m "$MODEM_ID" --messaging-list-sms \
    | grep -o '/org/freedesktop/ModemManager1/SMS/[0-9]\+' \
    | sed 's#.*/##' \
    | sort -n)"

  if [[ -z "$sms_ids" ]]; then
    echo "No SMS messages found."
    return 0
  fi

  local id
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    printf '===== SMS %s =====\n' "$id"
    read_sms "$id"
    echo
  done <<< "$sms_ids"
}

sender_number_for_sms() {
  local id="$1"
  local sms_path
  local details
  sms_path="$(resolve_sms_path "$id")"
  details="$(mmcli -s "$sms_path")"

  local number
  number="$(printf '%s\n' "$details" | sed -nE 's/^[[:space:]]*(number|Number):[[:space:]]*([+0-9]+).*$/\2/p' | head -n1)"
  if [[ -z "$number" ]]; then
    echo "Could not find a sender number for SMS $id" >&2
    exit 1
  fi
  printf '%s\n' "$number"
}

reply_sms() {
  local id="$1"
  shift
  local number
  number="$(sender_number_for_sms "$id")"
  send_sms "$number" "$@"
}

send_sms() {
  local recipient="$1"
  shift
  local text="$*"
  if [[ -z "$text" ]]; then
    echo "Message text cannot be empty" >&2
    exit 1
  fi

  local number
  number="$(resolve_recipient "$recipient")"

  if [[ "${SMS_DRY_RUN:-0}" == "1" ]]; then
    printf 'DRY RUN: would send SMS to %s\n' "$number"
    printf 'Text: %s\n' "$text"
    return 0
  fi

  ensure_modem_id
  local escaped_number
  local escaped_text
  escaped_number="$(escape_mmcli_value "$number")"
  escaped_text="$(escape_mmcli_value "$text")"

  local create_out
  create_out="$(mmcli -m "$MODEM_ID" --messaging-create-sms="number='$escaped_number',text='$escaped_text'")"

  local sms_path
  sms_path="$(printf '%s\n' "$create_out" | extract_path)"

  if [[ -z "$sms_path" ]]; then
    echo "Could not determine SMS path from mmcli output" >&2
    echo "$create_out" >&2
    exit 1
  fi

  mmcli -s "$sms_path" --send
}

templates() {
  if ! declare -p SMS_TEMPLATES >/dev/null 2>&1; then
    echo "No SMS_TEMPLATES defined in config file: $CONFIG_FILE" >&2
    exit 1
  fi

  local key
  for key in "${!SMS_TEMPLATES[@]}"; do
    printf '%s\n' "$key"
  done | sort
}

contacts() {
  if ! declare -p SMS_CONTACTS >/dev/null 2>&1; then
    echo "No SMS_CONTACTS defined in config file: $CONFIG_FILE" >&2
    exit 1
  fi

  local key
  for key in "${!SMS_CONTACTS[@]}"; do
    printf '%s -> %s\n' "$key" "${SMS_CONTACTS[$key]}"
  done | sort
}

send_template() {
  if ! declare -p SMS_TEMPLATES >/dev/null 2>&1; then
    echo "No SMS_TEMPLATES defined in config file: $CONFIG_FILE" >&2
    exit 1
  fi

  local name="$1"
  local msg="${SMS_TEMPLATES[$name]-}"
  local number
  shift

  if [[ -z "$msg" ]]; then
    echo "Template not found: $name" >&2
    echo "Defined templates:" >&2
    templates >&2 || true
    exit 1
  fi

  if [[ $# -gt 0 ]] && is_phone_number "$1"; then
    number="$1"
    shift
  elif declare -p SMS_CONTACTS >/dev/null 2>&1 && [[ -n "${SMS_CONTACTS[$name]-}" ]]; then
    number="${SMS_CONTACTS[$name]}"
  else
    echo "Usage: sms send-template <name> <number> [template_args...]" >&2
    echo "Or define SMS_CONTACTS[$name] in config and run: sms send-template <name> [template_args...]" >&2
    exit 1
  fi

  msg="$(render_template "$msg" "$@")"
  send_sms "$number" "$msg"
}

credit_status() {
  case "$CREDIT_METHOD" in
    ussd)
      if [[ "${SMS_DRY_RUN:-0}" == "1" ]]; then
        printf 'DRY RUN: would initiate USSD on modem %s\n' "$MODEM_ID"
        printf 'USSD: %s\n' "$CREDIT_USSD"
        return 0
      fi
      ensure_modem_id
      mmcli -m "$MODEM_ID" --3gpp-ussd-initiate="$CREDIT_USSD"
      ;;
    sms)
      send_sms "$CREDIT_SMS_NUMBER" "$CREDIT_SMS_TEXT"
      ;;
    *)
      echo "Invalid CREDIT_METHOD: $CREDIT_METHOD (expected: ussd or sms)" >&2
      exit 1
      ;;
  esac
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    list)
      list_sms
      ;;
    read)
      [[ $# -ge 2 ]] || { echo "Usage: sms read <id>" >&2; exit 1; }
      read_sms "$2"
      ;;
    read-all)
      read_all_sms
      ;;
    send)
      [[ $# -ge 3 ]] || { echo "Usage: sms send [--dry-run] <number-or-contact> <message>" >&2; exit 1; }
      if [[ "$2" == "--dry-run" ]]; then
        [[ $# -ge 4 ]] || { echo "Usage: sms send --dry-run <number-or-contact> <message>" >&2; exit 1; }
        SMS_DRY_RUN=1 send_sms "$3" "${*:4}"
      else
        send_sms "$2" "${*:3}"
      fi
      ;;
    reply)
      [[ $# -ge 3 ]] || { echo "Usage: sms reply [--dry-run] <id> <message>" >&2; exit 1; }
      if [[ "$2" == "--dry-run" ]]; then
        [[ $# -ge 4 ]] || { echo "Usage: sms reply --dry-run <id> <message>" >&2; exit 1; }
        SMS_DRY_RUN=1 reply_sms "$3" "${*:4}"
      else
        reply_sms "$2" "${*:3}"
      fi
      ;;
    templates)
      templates
      ;;
    contacts)
      contacts
      ;;
    send-template)
      [[ $# -ge 2 ]] || { echo "Usage: sms send-template <name> [number] [template_args...]" >&2; exit 1; }
      send_template "$2" "${@:3}"
      ;;
    credit-status)
      if [[ $# -eq 1 ]]; then
        credit_status
      elif [[ $# -eq 2 && "$2" == "--dry-run" ]]; then
        SMS_DRY_RUN=1 credit_status
      else
        echo "Usage: sms credit-status [--dry-run]" >&2
        exit 1
      fi
      ;;
    help|-h|--help|"")
      usage
      ;;
    *)
      echo "Unknown command: $cmd" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
